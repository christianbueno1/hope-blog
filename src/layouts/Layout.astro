---
import '../styles/global.css';
import Head from '../components/Head.astro';

const { title, description, image, type } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<Head title={title} description={description} image={image} type={type} />
	</head>
	<body>
		<slot />
	</body>
</html>
<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>