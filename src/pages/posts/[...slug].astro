---
// src/pages/posts/[...slug].astro
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("posts", ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString("es-EC", {
	day: "numeric",
	month: "long",
	year: "numeric",
});
---

<Layout
	title={`${post.data.title} — Hope Blog`}
	description={post.data.description}
>
	<style>
		@import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap");

		.font-display {
			font-family: "Space Grotesk", system-ui, sans-serif;
		}
		.font-code {
			font-family: "JetBrains Mono", ui-monospace, monospace;
		}

		/* Estilos para el contenido markdown renderizado (fuera del scope del componente) */
		.post-content :global(h2) {
			font-family: "Space Grotesk", system-ui, sans-serif;
			font-size: 1.25rem;
			font-weight: 600;
			color: rgb(241 245 249);
			margin-top: 3rem;
		}
		/* h3, h4 */
		.post-content :global(h3) {
			font-family: "Space Grotesk", system-ui, sans-serif;
			font-size: 1.1rem;
			font-weight: 600;
			color: rgb(241 245 249);
			margin-top: 2.25rem;
		}
		.post-content :global(h4) {
			font-family: "Space Grotesk", system-ui, sans-serif;
			font-size: 1rem;
			font-weight: 600;
			color: rgb(226 232 240);
			margin-top: 2rem;
		}

		.post-content :global(p) {
			margin-top: 1.25rem;
		}
		.post-content :global(ul),
		.post-content :global(ol) {
			margin-top: 1.25rem;
			padding-left: 1.25rem;
		}
		.post-content :global(li) {
			margin-top: 0.5rem;
		}
		.post-content :global(ol) {
			list-style: decimal;
		}
		.post-content :global(ul) {
			list-style: disc;
		}
		.post-content :global(strong) {
			color: rgb(241 245 249);
			font-weight: 500;
		}
		.post-content :global(a) {
			color: rgb(45 212 191);
			text-decoration: underline;
			text-underline-offset: 4px;
		}
		.post-content :global(code) {
			font-family: "JetBrains Mono", ui-monospace, monospace;
			font-size: 0.9em;
			color: rgb(226 232 240);
			background: rgb(30 41 59 / 0.6);
			padding: 0.15em 0.4em;
			border: 1px solid rgb(30 41 59);
		}
		.post-content :global(.code-block-wrapper) {
			position: relative;
			margin-top: 1.5rem;
		}
		.post-content :global(.code-block-wrapper pre) {
			margin-top: 0;
			padding: 1rem;
			overflow-x: auto;
			background: rgb(15 23 42 / 0.6) !important;
			border: 1px solid rgb(30 41 59);
			border-radius: 0.375rem;
		}
		.post-content :global(pre code) {
			background: none;
			border: none;
			padding: 0;
		}

		.post-content :global(.copy-code-button) {
			position: absolute;
			top: 0.6rem;
			right: 0.6rem;
			display: flex;
			align-items: center;
			justify-content: center;
			width: 32px;
			height: 32px;
			color: rgb(148 163 184);
			/* background: rgb(15 23 42 / 0.85); */
			/* border: 1px solid rgb(51 65 85); */
			border-radius: 0.375rem;
			cursor: pointer;
			opacity: 0;
			transition:
				opacity 0.15s,
				color 0.15s,
				border-color 0.15s;
		}
		.post-content :global(.code-block-wrapper:hover .copy-code-button) {
			opacity: 1;
		}
		.post-content :global(.copy-code-button:hover) {
			/* color: rgb(45 212 191); */
			/* border-color: rgb(45 212 191); */
			background-color: rgb(45 212 191 / 0.2);
			/* background-color: rgb(45 212 191); */
		}
		.post-content :global(.copy-code-button svg) {
			width: 18px;
			height: 18px;
			flex-shrink: 0;
		}
		.post-content :global(hr) {
			margin-top: 3rem;
			border-color: rgb(30 41 59);
		}
		.post-content :global(img) {
			margin-top: 1.5rem;
			width: 100%;
			height: auto;
			border: 1px solid rgb(30 41 59);
		}
		.post-content :global(figcaption) {
			margin-top: 0.5rem;
			font-family: "JetBrains Mono", ui-monospace, monospace;
			font-size: 0.8rem;
			color: rgb(100 116 139);
		}

		/* for markdown tables: */
		.post-content :global(table) {
			margin-top: 1.5rem;
			width: 100%;
			border-collapse: collapse;
			font-size: 0.95em;
			display: block;
			overflow-x: auto;
		}
		.post-content :global(th),
		.post-content :global(td) {
			padding: 0.5rem 0.75rem;
			border: 1px solid rgb(30 41 59);
			text-align: left;
		}
		.post-content :global(th) {
			font-family: "Space Grotesk", system-ui, sans-serif;
			font-weight: 600;
			color: rgb(241 245 249);
			background: rgb(30 41 59 / 0.4);
		}
		.post-content :global(tbody tr:nth-child(even)) {
			background: rgb(30 41 59 / 0.2);
		}
	</style>

	<main
		class="min-h-screen bg-slate-950 text-slate-200"
		style="font-family: Inter, system-ui, sans-serif;"
	>
		<div class="mx-auto max-w-3xl px-5 py-16 sm:py-24">
			<a
				href="/"
				class="font-code text-sm text-slate-500 underline decoration-slate-800 underline-offset-4 hover:text-teal-400 hover:decoration-teal-400"
			>
				← hope-blog
			</a>

			<p class="font-code mt-6 text-xs text-slate-600">
				{post.data.category}/ · {formattedDate}
			</p>

			<h1
				class="font-display mt-3 text-3xl font-semibold leading-snug text-slate-100 sm:text-4xl"
			>
				{post.data.title}
			</h1>

			<div
				class="post-content mt-6 max-w-[62ch] text-lg leading-relaxed text-slate-300"
			>
				<Content />
			</div>
		</div>
	</main>
</Layout>

<script>
	const copyIconSVG = `<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
	<path d="M0 0h24v24H0z" fill="none" />
	<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
		<rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
		<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
	</g>
</svg>
`;

	const checkIconSVG = `<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
	<path d="M0 0h24v24H0z" fill="none" />
	<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 6L9 17l-5-5" />
</svg>
`;

	document.querySelectorAll(".post-content pre").forEach((pre) => {
		const wrapper = document.createElement("div");
		wrapper.className = "code-block-wrapper";

		const button = document.createElement("button");
		button.className = "copy-code-button";
		button.type = "button";
		button.setAttribute("aria-label", "Copy code to clipboard");
		button.innerHTML = copyIconSVG;

		pre.parentNode?.insertBefore(wrapper, pre);
		wrapper.appendChild(pre);
		wrapper.appendChild(button);

		button.addEventListener("click", async () => {
			const code = pre.querySelector("code");
			const text = code
				? (code.textContent ?? "")
				: (pre.textContent ?? "");

			try {
				await navigator.clipboard.writeText(text);
				button.innerHTML = checkIconSVG;
			} catch {
				button.innerHTML = copyIconSVG;
			}

			setTimeout(() => {
				button.innerHTML = copyIconSVG;
			}, 2000);
		});
	});
</script>
